# Base URL of the Express API. No trailing slash, the app appends /api/... itself.
VITE_API_URL=http://localhost:5000

# Supabase project used for the design-photo upload on the custom design page.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth client id for the "Continue with Google" button on the auth pages.
VITE_GOOGLE_CLIENT_ID=
